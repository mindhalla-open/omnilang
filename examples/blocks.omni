module acme.phase1

type productId = uuid
type orderId = uuid
type orderSummary = string

type serializable = struct
  id uuid

type apiResponse<T: serializable, E> = struct
  data T
  error E?

type paymentStatus = enum
  Success
  Failed
  Cancelled

type value = int | float | string?

service checkout
  goal "Perform user checkout"
  depends_on:
    - payments
  constraints:
    - pciCompliant

service payments
  goal "Process card payments"
  constraints:
    - pciCompliant
  invariants:
    - balance >= 0
    - transaction_count >= 0

orchestrator orderFulfillment
  goal "Manage order lifecycle"

  states: [Placed, PaymentPending, Shipped, Cancelled]

  transitions:
    - Placed -> PaymentPending -> Shipped
    - PaymentPending -> Cancelled [on: PaymentFailed]

  invariants:
    - shipment_safety: "An order can only be Shipped after PaymentPending succeeds"

schema ecommerceDb
  goal "E-commerce data model"
  target postgresql

  entity product
    id productId @primary
    name string @indexed

  relations:
    - customer has_many orders

constraint pciCompliant
  requires:
    - authenticated
    - audit_logging
